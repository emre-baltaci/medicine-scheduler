# Shared editor settings (Android Studio, Cursor/VS Code, most editors read this file)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Kotlin and Gradle: official Kotlin style (4 spaces)
[*.{kt,kts,gradle}]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
